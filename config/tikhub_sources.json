      "scope": "/api/v1/weibo/web/",
      "method": "GET",
      "endpoint": "/api/v1/weibo/web/fetch_search",
      "query_param": "keyword",
      "default_params": {},
      "queries": [
        "大疆 降价",
        "影石 新品",
        "NVIDIA 显卡 降价",
        "以旧换新 补贴 数码",
