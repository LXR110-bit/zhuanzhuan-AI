{
  "version": "1.0.0",
  "updated_at": "2026-04-29",
  "enabled": true,
  "base_url_env": "TIKHUB_BASE_URL",
  "api_key_env": "TIKHUB_API_KEY",
  "timeout_seconds": 45,
  "max_items_per_source": 8,
  "max_age_days": 7,
  "output": "data/news_signals.json",
  "platform_priority": [
    "douyin",
    "xiaohongshu",
    "bilibili",
    "weibo",
    "toutiao"
  ],
  "sources": [
    {
      "id": "douyin_market",
      "enabled": true,
      "platform": "douyin",
      "scope": "/api/v1/douyin/search/",
      "method": "POST",
      "endpoint": "/api/v1/douyin/search/fetch_general_search_v1",
      "query_param": "keyword",
      "default_params": {
        "cursor": "0",
        "sort_type": "0",
        "publish_time": "0",
        "count": 5
      },
      "queries": [
        "华强北 今日行情 数码 回收",
        "二手数码 回收商 报价",
        "大疆 Pocket 回收 最新报价",
        "GoPro 二手 价格",
        "显卡 降价 二手 行情"
      ],
      "level": "A",
      "credibility_weight": 0.78
    },
    {
      "id": "xiaohongshu_market",
      "enabled": true,
      "platform": "xiaohongshu",
      "scope": "/api/v1/xiaohongshu/web_v3/",
      "method": "GET",
      "endpoint": "/api/v1/xiaohongshu/web_v3/fetch_search_notes",
      "query_param": "keyword",
      "default_params": {
        "page": 1,
        "sort": "time_descending",
        "note_type": "0"
      },
      "queries": [
        "大疆 Pocket 回收",
        "影石 X5 二手",
        "运动相机 二手行情",
        "数码产品 以旧换新",
        "华强北 回收 行情"
      ],
      "level": "B",
      "credibility_weight": 0.72
    },
    {
      "id": "bilibili_reviews",
      "enabled": true,
      "platform": "bilibili",
      "scope": "/api/v1/bilibili/app/",
      "method": "GET",
      "endpoint": "/api/v1/bilibili/app/fetch_search_all",
      "query_param": "keyword",
      "default_params": {
        "page": 1
      },
      "queries": [
        "RTX 4070 二手 价格",
        "DDR5 内存 价格",
        "DJI Pocket 4 评测",
        "Insta360 X5 评测"
