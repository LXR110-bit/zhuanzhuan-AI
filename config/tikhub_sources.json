      "level": "A",
      "credibility_weight": 0.75
    },
    {
      "id": "toutiao_news",
      "enabled": false,
      "platform": "toutiao",
      "scope": "/api/v1/toutiao/web/",
      "method": "GET",
      "endpoint": "/api/v1/toutiao/web/search",
      "queries": [
        "二手数码 行情 今日",
