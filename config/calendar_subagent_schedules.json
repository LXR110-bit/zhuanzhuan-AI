{
  "version": "2.17.0",
  "updated_at": "2026-06-17",
  "execution_model": "Calendar -> price/signal Agent -> cloud bash/mobile_use/TikHub/search_web/multi-engine candidates -> Python post-processing -> Feishu/Coze outputs",
  "source_templates": {
    "sub_agent_execution": "扣子原价格爬取功能/sub-agent执行方式说明_20260429.md",
    "calendar_description": "扣子原价格爬取功能/日程描述模板_20260429.md",
    "tool_calls": "扣子原价格爬取功能/工具调用模板_20260429.md"
  },
  "hard_rules": [
    "价格监控Agent只负责采价、价格校验、日报价格产物和价格推送",
    "信号监控Agent只负责资讯/热点/政策/新品信号采集、去重、分级和信号推送",
    "价格Agent不得主动调用TikHub/search_web做热点扩展",
    "信号Agent不得调用mobile_use采价，不得写data/price_cache.json",
    "多引擎搜索只作为平台政策候选线索层；未经过官方/API/截图/OCR/人工复核不得写成已确认结论",
    "日常循环只创建4条MO-FR：06:00价格、08:30信号、10:00价格推送、15:30信号补扫",
    "18:00价格机动和20:30信号机动不得创建MO-FR循环，只能非循环/手动触发",
    "真实webhook/secret只放.env或环境变量，不写description、日志或Git",
    "刘司令不得创建代执行日程"
  ],
  "tikhub_config": {
    "endpoints": {
      "bilibili": "https://api.tikhub.dev/api/v1/bilibili/app/fetch_search_all?keyword={keyword}&page=1",
      "xiaohongshu": "https://api.tikhub.dev/api/v1/xiaohongshu/web_v3/fetch_search_notes?keyword={keyword}&page=1"
    },
    "api_key_source": "SECRET.md",
    "cache_ttl_hours": 24,
    "search_keywords": {
      "显卡": {
        "frequency": "daily",
        "bilibili": "RTX4070 二手价格",
        "xiaohongshu": "显卡 矿难",
        "xiaohongshu_days": [
          1,
          4
        ]
      },
      "运动相机": {
        "frequency": "daily",
        "bilibili": "Pocket3 二手回收",
        "xiaohongshu": "运动相机 出",
        "xiaohongshu_days": [
          1,
          5
        ]
      },
      "CPU": {
        "frequency": "mon_wed_fri",
        "bilibili": "13600K 二手",
        "xiaohongshu": null
      },
      "无人机": {
        "frequency": "mon_wed_fri",
        "bilibili": "大疆Mini4 二手",
        "xiaohongshu": null
      },
      "内存固态": {
        "frequency": "mon_thu",
        "bilibili": "DDR5内存 价格",
        "xiaohongshu": null
      },
      "智能手环": {
        "frequency": "mon",
        "bilibili": "小米手环10 回收",
        "xiaohongshu": null
      }
    }
  },
  "post_processing_steps": [
    "python3 scripts/price_data_validator.py",
    "python3 scripts/price_daily_recorder.py",
    "python3 scripts/price_archiver.py archive",
    "python3 scripts/fetch_tikhub_signals.py --append",
    "python3 scripts/news_signal_filter.py",
    "python3 scripts/generate_daily_report_payload.py",
    "python3 scripts/render_cards_html.py"
  ],
  "schedules": {
    "price_morning_full": {
      "agent": "侦察兵小C_价格监控",
      "calendar_summary": "早盘价格全量任务包",
      "schedule": "WEEKLY MO-FR 06:00",
      "workday_only": true,
      "sub_agent_tools": [
        "bash",
        "mobile_use"
      ],
      "push_enabled": false,
      "python_after_tools": [
        "python3 scripts/price_data_validator.py",
        "python3 scripts/price_daily_recorder.py",
        "python3 scripts/price_archiver.py archive",
        "python3 scripts/generate_daily_report_payload.py",
        "python3 scripts/render_cards_html.py"
      ],
      "forbidden_tools": [
        "fetch_tikhub_signals.py",
        "news_signal_filter.py",
        "search_web热点扩展"
      ]
    },
    "signal_morning_radar": {
      "agent": "侦察兵小B_信号监控",
      "calendar_summary": "早盘信号雷达",
      "schedule": "WEEKLY MO-FR 08:30",
      "workday_only": true,
      "sub_agent_tools": [
        "bash",
        "search_web"
      ],
      "push_enabled": "S/A only to Feishu",
      "python_after_tools": [
        "python3 scripts/multi_engine_search.py --profile platform_policy --dry-run",
        "python3 scripts/fetch_tikhub_signals.py --append",
        "python3 scripts/news_signal_filter.py",
        "python3 scripts/send_signal_digest.py"
      ],
      "forbidden_tools": [
        "mobile_use",
        "price_cache写入"
      ],
      "platform_policy_candidate_flow": [
        "先用multi_engine_search.py --dry-run生成多引擎搜索任务清单",
        "由信号Agent/search_web按清单抽样采集候选结果并整理为JSON",
        "用multi_engine_search.py --input归一化为data/platform_policy_candidates.json",
        "send_signal_digest.py只按待验证候选展示运营承接预备；不得当作已确认政策"
      ]
    },
    "price_daily_push": {
      "agent": "侦察兵小C_价格监控",
      "calendar_summary": "价格日报推送任务包",
      "schedule": "WEEKLY MO-FR 10:00",
      "workday_only": true,
      "sub_agent_tools": [
        "bash"
      ],
      "push_enabled": "Feishu + Coze; WeCom fallback before cutover",
      "python_after_tools": [
        "python3 scripts/send_daily_report.py --channel feishu"
      ],
      "forbidden_tools": [
        "mobile_use重采价",
        "fetch_tikhub_signals.py",
        "news_signal_filter.py"
      ]
    },
    "signal_afternoon_rescan": {
      "agent": "侦察兵小B_信号监控",
      "calendar_summary": "午后信号补扫",
      "schedule": "WEEKLY MO-FR 15:30",
      "workday_only": true,
      "sub_agent_tools": [
        "bash",
        "search_web"
      ],
      "push_enabled": "S/A only to Feishu",
      "python_after_tools": [
        "python3 scripts/multi_engine_search.py --profile platform_policy --dry-run",
        "python3 scripts/fetch_tikhub_signals.py --append",
        "python3 scripts/news_signal_filter.py",
        "python3 scripts/send_signal_digest.py"
      ],
      "forbidden_tools": [
        "mobile_use",
        "price_cache写入"
      ],
      "platform_policy_candidate_flow": [
        "先用multi_engine_search.py --dry-run生成多引擎搜索任务清单",
        "由信号Agent/search_web按清单抽样采集候选结果并整理为JSON",
        "用multi_engine_search.py --input归一化为data/platform_policy_candidates.json",
        "send_signal_digest.py只按待验证候选展示运营承接预备；不得当作已确认政策"
      ]
    },
    "price_evening_flex": {
      "agent": "侦察兵小C_价格监控",
      "calendar_summary": "晚盘价格机动任务包",
      "schedule": "NON_RECURRING_OR_MANUAL 18:00",
      "workday_only": false,
      "sub_agent_tools": [
        "bash",
        "mobile_use"
      ],
      "push_enabled": "major price anomaly only",
      "python_after_tools": [
        "python3 scripts/price_data_validator.py",
        "python3 scripts/price_archiver.py archive"
      ],
      "not_mo_fr": true
    },
    "signal_evening_flex": {
      "agent": "侦察兵小B_信号监控",
      "calendar_summary": "晚间信号机动任务包",
      "schedule": "NON_RECURRING_OR_MANUAL 20:30",
      "workday_only": false,
      "sub_agent_tools": [
        "bash",
        "search_web"
      ],
      "push_enabled": "S/A only to Feishu",
      "python_after_tools": [
        "python3 scripts/multi_engine_search.py --profile platform_policy --dry-run",
        "python3 scripts/fetch_tikhub_signals.py --append",
        "python3 scripts/news_signal_filter.py",
        "python3 scripts/send_signal_digest.py"
      ],
      "not_mo_fr": true,
      "platform_policy_candidate_flow": [
        "先用multi_engine_search.py --dry-run生成多引擎搜索任务清单",
        "由信号Agent/search_web按清单抽样采集候选结果并整理为JSON",
        "用multi_engine_search.py --input归一化为data/platform_policy_candidates.json",
        "send_signal_digest.py只按待验证候选展示运营承接预备；不得当作已确认政策"
      ]
    }
  },
  "agent_split": {
    "price_agent": "侦察兵小C_价格监控",
    "signal_agent": "侦察兵小B_信号监控",
    "shared_repo": "github.com/LXR110-bit/zhuanzhuan-AI.git",
    "branch": "local/dev",
    "cloud_dir": "/root/coze-production/zhuanzhuan-AI",
    "daily_loop_instances_per_week": 20,
    "flex_tasks_are_non_recurring": true
  },
  "feishu": {
    "enabled_after_env_config": true,
    "price_webhook_env": "FEISHU_PRICE_WEBHOOK_URL",
    "signal_webhook_env": "FEISHU_SIGNAL_WEBHOOK_URL",
    "fallback_webhook_env": "FEISHU_WEBHOOK_URL",
    "price_prefix": "【价格监控】",
    "signal_prefix": "【信号监控】",
    "daily_doc_dir": "data/feishu_daily_docs/YYYY-MM-DD/"
  },
  "multi_search_config": {
    "config_file": "config/multi_search_sources.json",
    "default_profile": "platform_policy",
    "output": "data/platform_policy_candidates.json",
    "role": "信号Agent平台政策候选线索发现；输出运营流量承接预备，不替代API/官方页/截图证据",
    "default_steps": [
      "python3 scripts/multi_engine_search.py --profile platform_policy --dry-run",
      "如Agent已用search_web采集到候选结果，整理为JSON后执行：python3 scripts/multi_engine_search.py --profile platform_policy --input <search_results.json>",
      "仅在明确需要且环境允许时使用：python3 scripts/multi_engine_search.py --profile platform_policy --fetch-direct"
    ],
    "evidence_gate": "candidate_only_pending_verification"
  }
}
