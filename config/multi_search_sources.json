{
  "version": "1.0.0",
  "updated_at": "2026-06-17",
  "enabled": true,
  "purpose": "多引擎搜索作为信号监控Agent的平台政策候选线索层；只用于发现线索，不作为已确认政策事实源。",
  "default_profile": "platform_policy",
  "output": "data/platform_policy_candidates.json",
  "timeout_seconds": 12,
  "delay_seconds": 1.2,
  "max_results_per_engine": 5,
  "max_candidates": 40,
  "min_score": 40,
  "fetch_direct_default": false,
  "evidence_rules": {
    "candidate_only": "多引擎搜索结果默认均为待验证线索，不得直接写成已确认结论。",
    "promote_to_confirmed_requires_any": [
      "官方/API返回的活动或券字段",
      "平台官方活动页URL",
      "商品页或结算页截图/OCR券面文字",
      "人工核验记录"
    ]
  },
  "profiles": {
