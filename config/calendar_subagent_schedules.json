{
  "version": "2.6.0",
  "updated_at": "2026-04-30",
  "execution_model": "Calendar -> sub-agent -> search_web/mobile_use -> Python post-processing",
  "source_templates": {
    "sub_agent_execution": "扣子原价格爬取功能/sub-agent执行方式说明_20260429.md",
    "calendar_description": "扣子原价格爬取功能/日程描述模板_20260429.md",
    "tool_calls": "扣子原价格爬取功能/工具调用模板_20260429.md"
  },
  "hard_rules": [
    "数据爬取必须由Calendar触发sub-agent完成",
    "sub-agent负责调用search_web和mobile_use",
    "Python脚本不得用requests替代search_web/mobile_use爬取",
    "sub-agent写入data/price_cache.json后，才能调用Python后处理脚本",
    "price_crawler.py和run_daytime_scan.py为废弃入口，不得作为日程入口"
  ],
  "post_processing_steps": [
    "python3 scripts/price_data_validator.py",
    "python3 scripts/price_daily_recorder.py",
    "python3 scripts/price_archiver.py archive",
    "python3 scripts/fetch_tikhub_signals.py --append",
    "python3 scripts/news_signal_filter.py",
    "python3 scripts/generate_daily_report_payload.py",
    "python3 scripts/render_cards_html.py"
  ],
  "schedules": {
    "daily_report": {
      "calendar_summary": "市场追踪日报",
      "time": "06:00",
      "description_template": "日程描述模板_20260429.md#三、市场追踪日报",
      "sub_agent_tools": ["search_web", "bash"],
      "required_price_backfill": {
        "enabled": true,
        "config_source": "config/categories.json",
        "model_count": 26,
        "categories": ["运动相机", "显卡", "CPU", "内存固态", "无人机", "智能手环"],
        "platform": "xianyu_market",
        "query_template": "{search_keyword} 闲鱼 二手 9成新 价格 2026",
        "write_target": "data/price_cache.json",
        "note": "06:00日报必须先用search_web补全全量26个机型自由市场价，再生成payload和HTML PNG卡片。"
      },
      "python_after_tools": [
        "python3 scripts/fetch_tikhub_signals.py --append",
        "python3 scripts/news_signal_filter.py",
        "python3 scripts/generate_daily_report_payload.py",
        "python3 scripts/render_cards_html.py"
      ]
    },
    "daytime_anomaly_detection": {
      "calendar_summary": "白天异动检测",
      "times": ["07:30", "12:00", "17:30"],
      "description_template": "日程描述模板_20260429.md#一、白天异动检测",
      "sub_agent_tools": ["search_web", "mobile_use", "bash"],
      "python_after_tools": [
        "python3 scripts/price_data_validator.py",
        "python3 scripts/price_daily_recorder.py",
        "python3 scripts/price_archiver.py archive",
        "python3 scripts/generate_daily_report_payload.py",
        "python3 scripts/render_cards_html.py"
      ]
    },
    "evening_full_scan": {
      "calendar_summary": "晚间全量检测",
      "time": "21:00",
      "description_template": "日程描述模板_20260429.md#二、晚间全量检测",
      "sub_agent_tools": ["mobile_use", "search_web", "bash"],
      "required_price_sources": ["xianyu_market", "xianyu_official", "aihuishou"],
      "python_after_tools": [
        "python3 scripts/price_data_validator.py",
        "python3 scripts/price_daily_recorder.py",
        "python3 scripts/price_archiver.py archive",
        "python3 scripts/generate_daily_report_payload.py",
        "python3 scripts/render_cards_html.py"
      ]
    },
    "daily_report_push": {
      "calendar_summary": "日报推送",
      "time": "10:00",
      "description_template": "日程描述模板_20260429.md#五、日报推送",
      "sub_agent_tools": ["bash"],
      "push_steps": [
        "检查 data/report_cards/ 下当天PNG卡片是否存在",
        "存在 → 推送两张卡片到扣子主对话 + 企业微信webhook",
        "不存在 → 在扣子主对话报告异常（06:00日报生成失败）"
      ],
      "python_after_tools": []
    },
    "cloud_pc_scan": {
      "calendar_summary": "云电脑扫描",
      "times": ["08:00", "10:30", "12:30", "14:00", "16:00", "18:00", "20:00", "22:00"],
      "description_template": "日程描述模板_20260429.md#四、云电脑扫描",
      "sub_agent_tools": ["search_web", "bash"],
      "python_after_tools": [
        "python3 scripts/price_data_validator.py",
        "python3 scripts/price_archiver.py archive"
      ]
    },
    "baseline_update": {
      "calendar_summary": "基准线自适应更新",
      "schedule": "WEEKLY MO 05:30",
      "description_template": "v2.6新增",
      "sub_agent_tools": ["bash"],
      "python_after_tools": [
        "python3 scripts/update_baseline.py --mode adaptive"
      ]
    },
    "weekly_trend_report": {
      "calendar_summary": "周趋势报告",
      "schedule": "WEEKLY MO 09:00",
      "description_template": "v2.6新增",
      "sub_agent_tools": ["bash"],
      "python_after_tools": [
        "python3 scripts/generate_periodic_trend_report.py --period weekly",
        "python3 scripts/send_periodic_report.py --period weekly"
      ]
    },
    "monthly_trend_report": {
      "calendar_summary": "月趋势报告",
      "schedule": "MONTHLY day1 09:00",
      "description_template": "v2.6新增",
      "sub_agent_tools": ["bash"],
      "python_after_tools": [
        "python3 scripts/generate_periodic_trend_report.py --period monthly",
        "python3 scripts/send_periodic_report.py --period monthly"
      ]
    },
    "daytime_incremental_scan": {
      "calendar_summary": "日间增量巡检",
      "times": ["10:15", "14:15", "18:15"],
      "description_template": "v2.6新增",
      "sub_agent_tools": ["search_web", "bash"],
      "python_after_tools": [
        "python3 scripts/fetch_tikhub_signals.py --append",
        "python3 scripts/news_signal_filter.py"
      ]
    }
  }
}
